{
  "name": "Evento",
  "type": "object",
  "properties": {
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "telefone": {
      "type": "string"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do evento"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "andamento",
        "sucesso",
        "insucesso"
      ],
      "default": "aguardando"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "venda",
        "pos_venda",
        "agendamento",
        "retorno"
      ],
      "default": "venda"
    },
    "origem": {
      "type": "string",
      "enum": [
        "telefone",
        "whatsapp",
        "site",
        "showroom",
        "indicacao"
      ],
      "default": "telefone"
    },
    "temperatura": {
      "type": "string",
      "enum": [
        "frio",
        "morno",
        "quente"
      ],
      "default": "morno"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "Macom Ananindeua",
        "Macom Bel\u00e9m",
        "Macom Paragominas"
      ],
      "default": "Macom Ananindeua"
    },
    "modelo_interesse": {
      "type": "string"
    },
    "proximo_contato": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome",
    "titulo"
  ]
}