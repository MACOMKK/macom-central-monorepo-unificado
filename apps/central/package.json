{
  "name": "central",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "prebuild": "node ../../scripts/syncFavicons.js",
    "build": "vite build --configLoader runner",
    "generate:pwa-icons": "pwa-assets-generator --config pwa-assets.config.js",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix",
    "test": "vitest --configLoader runner",
    "test:run": "vitest run --configLoader runner",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview --configLoader runner"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^1.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
